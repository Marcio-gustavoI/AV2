# ============================================================
# greencode — variáveis de ambiente
# Copie para .env e preencha os valores reais.
# NUNCA comite o .env no repositório.
# ============================================================

# --- Servidor ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Banco de dados ---
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://greencode:greencode@localhost:5432/greencode"

# --- Banco de dados de teste (separado do principal) ---
DATABASE_URL_TEST="postgresql://greencode:greencode@localhost:5432/greencode_test"

# --- Autenticação ---
# Mínimo 32 caracteres; gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="SUBSTITUA_POR_SEGREDO_FORTE_COM_MINIMO_32_CHARS_AQUI"
# Formato: 30m, 1h, 2h
JWT_EXPIRA_EM="30m"

# --- Senhas (bcryptjs) ---
# Custo de hash (salt rounds). Padrão 12, mínimo 10.
BCRYPT_ROUNDS=12

# --- CORS ---
# Lista de origens permitidas, separadas por vírgula.
# Exemplo: CORS_ORIGENS=http://localhost:5173,https://app.greencode.com.br
# Vazio = bloqueia origens externas (apenas same-origin).
CORS_ORIGENS=

# --- Timezone de negócio (regras de data) ---
TZ_NEGOCIO=America/Sao_Paulo

# --- Logs ---
# Tamanho máximo do arquivo de log antes de rotar: "10m" = 10 megabytes
LOG_MAX_SIZE=10m
# Nível: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# --- Auditoria ---
# Retenção mínima: 180 dias. Valores menores são rejeitados pelo script.
AUDITORIA_RETENCAO_DIAS=180

# --- Shutdown ---
# Tempo (ms) para aguardar requisições em andamento antes de forçar saída
SHUTDOWN_TIMEOUT_MS=10000

# --- Admin (usado pelo script criar-admin) ---
# ADMIN_EMAIL=admin@greencode.com.br
# ADMIN_SENHA=SenhaForte123
