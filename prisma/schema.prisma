// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum Papel {
  ADMIN
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum EstadoFisico {
  SUCATA // 0 - pior
  RUIM // 1
  REGULAR // 2
  BOM // 3
  EXCELENTE // 4 - melhor
}

enum StatusEquipamento {
  RECEBIDO
  EM_TRIAGEM
  TRIADO
  EM_DESMONTE
  DESMONTADO
  DESTINADO
}

enum TipoEquipamento {
  DESKTOP
  NOTEBOOK
  MONITOR
  SERVIDOR
  PERIFERICO
  REDE
  OUTRO
}

enum ClassificacaoDestino {
  REUTILIZACAO
  RECICLAGEM
  DESCARTE_SEGURO
}

// ===================== MODELS =====================

model Usuario {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  senhaHash String   @map("senha_hash")
  papel     Papel
  ativo     Boolean  @default(true)
  versao    Int      @default(1)
  criadoEm  DateTime @default(now()) @map("criado_em")

  movimentacoes Movimentacao[]
  auditorias    Auditoria[]

  @@map("usuarios")
}

model Parametro {
  chave        String   @id
  valor        Decimal  @db.Decimal(18, 6)
  versao       Int      @default(1)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("parametros")
}

model Organizacao {
  id       String   @id @default(uuid()) @db.Uuid
  codigo   String   @unique
  cnpj     String   @unique @db.VarChar(14)
  nome     String
  versao   Int      @default(1)
  criadoEm DateTime @default(now()) @map("criado_em")

  contrato Contrato?
  lotes    Lote[]

  @@index([criadoEm])
  @@map("organizacoes")
}

model Contrato {
  id            String    @id @default(uuid()) @db.Uuid
  organizacaoId String    @unique @map("organizacao_id") @db.Uuid
  numero        String    @unique
  clausulas     Json?
  inicio        DateTime  @db.Date
  fim           DateTime? @db.Date
  versao        Int       @default(1)

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)

  @@map("contratos")
}

model Lote {
  id             String   @id @default(uuid()) @db.Uuid
  organizacaoId  String   @map("organizacao_id") @db.Uuid
  notaFiscal     String   @map("nota_fiscal")
  transportadora String
  dataEntrada    DateTime @map("data_entrada") @db.Date
  versao         Int      @default(1)
  criadoEm       DateTime @default(now()) @map("criado_em")

  organizacao  Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  equipamentos Equipamento[]

  @@index([organizacaoId])
  @@index([criadoEm])
  @@map("lotes")
}

model Equipamento {
  id                   String                @id @default(uuid()) @db.Uuid
  loteId               String                @map("lote_id") @db.Uuid
  codigoBarrasInterno  String                @unique @map("codigo_barras_interno")
  tipo                 TipoEquipamento
  descricao            String
  valorAquisicao       Decimal?              @map("valor_aquisicao") @db.Decimal(18, 2)
  estadoFisico         EstadoFisico          @map("estado_fisico")
  status               StatusEquipamento     @default(RECEBIDO)
  triagemCompleta      Boolean               @default(false) @map("triagem_completa")
  classificacaoDestino ClassificacaoDestino? @map("classificacao_destino")
  versao               Int                   @default(1)
  criadoEm             DateTime              @default(now()) @map("criado_em")

  lote          Lote           @relation(fields: [loteId], references: [id], onDelete: Restrict)
  movimentacoes Movimentacao[]

  @@index([loteId])
  @@index([status])
  @@index([criadoEm])
  @@map("equipamentos")
}

model Movimentacao {
  id             String            @id @default(uuid()) @db.Uuid
  equipamentoId  String            @map("equipamento_id") @db.Uuid
  statusAnterior StatusEquipamento @map("status_anterior")
  statusNovo     StatusEquipamento @map("status_novo")
  estadoAnterior EstadoFisico      @map("estado_anterior")
  estadoNovo     EstadoFisico      @map("estado_novo")
  justificativa  String?
  usuarioId      String            @map("usuario_id") @db.Uuid
  versao         Int               @default(1)
  criadoEm       DateTime          @default(now()) @map("criado_em")

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([equipamentoId])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("movimentacoes")
}

model Auditoria {
  id         String   @id @default(uuid()) @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  acao       String
  entidade   String
  entidadeId String   @map("entidade_id")
  antes      Json?
  depois     Json?
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
  @@index([entidade])
  @@index([criadoEm])
  @@map("auditorias")
}
